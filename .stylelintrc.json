{
  "extends": ["stylelint-config-standard"],
  "rules": {
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "theme",
          "import",
          "utility",
          "variant",
          "plugin",
          "source",
          "custom-variant"
        ]
      }
    ]
  }
}
